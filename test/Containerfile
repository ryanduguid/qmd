FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl ca-certificates bash git build-essential python3 libatomic1 && \
    rm -rf /var/lib/apt/lists/*

# Verify the pinned mise installer before execution. Update the tag and hash together.
ENV MISE_YES=1
RUN curl --fail --show-error --silent --location --proto '=https' --proto-redir '=https' \
      "https://github.com/jdx/mise/releases/download/v2026.10.6/install.sh" \
      --output /tmp/mise-install.sh && \
    printf '%s  %s\n' \
      '2caf53ecf2833beec55b096f49d580ca795f9ee01dd4dc7d7eb3185dfe118fe0' \
      '/tmp/mise-install.sh' | sha256sum --check --strict - && \
    MISE_VERSION=v2026.10.6 sh /tmp/mise-install.sh && \
    rm -f /tmp/mise-install.sh
ENV PATH="/root/.local/bin:$PATH"

# Pre-install node and bun
RUN mise use -g node@latest bun@latest

# Copy the packed tarball and install via both package managers. Keep a stable
# tarball path for npm-exec/npx-style smoke scenarios.
COPY tobilu-qmd-*.tgz /tmp/qmd-package.tgz
RUN cp /tmp/qmd-package.tgz /tmp/tobilu-qmd.tgz
RUN mise exec node@latest -- npm install -g /tmp/qmd-package.tgz
RUN mise exec bun@latest -- bun install -g /tmp/qmd-package.tgz

# Copy test project (src + test + configs) and install deps
COPY test-src/ /opt/qmd/
RUN cd /opt/qmd && mise exec node@latest -- npm install 2>/dev/null
RUN cd /opt/qmd && mise exec bun@latest -- bun install 2>/dev/null || true

# Put everything on PATH
ENV PATH="/root/.bun/bin:/root/.local/share/mise/shims:/root/.local/bin:$PATH"

CMD ["bash"]
